ANTHROPIC_API_KEY=
# Model for per-product impact estimates (what one unit of a shop's product replaces). Optional.
# PRODUCT_IMPACT_MODEL=claude-opus-5-5
DATABASE_URL=postgres://postgres:pg@localhost:5433/ecoproof
# Base58 secret key of a devnet wallet (optional locally)
SOLANA_SECRET_KEY=
# SOLANA_RPC_URL=https://api.devnet.solana.com
# Soulbound NFTs: run `npx tsx scripts/nft-setup.ts` once and paste its output. APP_URL = public base URL used in NFT metadata.
NFT_TREE_ADDRESS=
NFT_COLLECTION_ADDRESS=
# APP_URL=https://your-app.vercel.app
# Required in production (>= 32 chars). Signs sessions and Better Auth; a dev-only fallback is used locally.
SESSION_SECRET=
# Protects /admin and the admin API routes (at least 16 chars). Leave empty to disable them.
ADMIN_TOKEN=
# Google and Facebook sign-in (v2). Each button only appears when both of its keys are set.
# Redirect URI to register: <site>/api/account/callback/google (or /facebook).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Model for order category estimates. Optional.
# CATEGORY_MODEL=claude-sonnet-5-5
# Fallback for metadataBase when APP_URL is unset. Optional.
# NEXT_PUBLIC_SITE_URL=https://ecoproof.superbee.me
